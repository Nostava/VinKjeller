# Vinmonopol's official API key — https://api.vinmonopolet.no
# (already created for this project; do NOT commit the real key)
VINMONOPOLET_API_KEY=

# Product data mode:
#   thin (default) = products v0 + stores v0 + monthly sales (works today)
#   rich           = + my-products v1 (full master data + GTIN barcodes; requires access)
PRODUCT_DATA_MODE=thin

# Hotlink product images from Vinmonopol's public image CDN (true/false)
HOTLINK_IMAGES=true

# Server
PORT=3001
HOST=0.0.0.0

# CORS origins for local dev (comma separated) — not needed in production (same origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
